# Copy to .env (local) or set these as GitHub Actions secrets. Do NOT commit real values.

# --- Shopify (required) ---
# The store's .myshopify.com domain (NOT the admin handle f260e4). Find it under
# Settings -> Domains, or it's shown in the admin URL of the Apps API section.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Admin API access token from a custom app (Settings -> Apps -> Develop apps),
# with the read_products scope. Starts with shpat_...
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-10

# --- Feed content ---
STORE_URL=https://aya-s.com
FEED_CURRENCY=DKK
BRAND_DEFAULT=AYA-S
DEFAULT_GOOGLE_CATEGORY=Apparel & Accessories > Clothing
CATEGORY_MAP_PATH=category_map.csv

# --- Output / tuning ---
OUTPUT_PATH=output/google_feed.xml
FEED_PAGE_SIZE=20
